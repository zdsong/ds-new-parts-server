<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.newpart.externalwarehouse.biz.mapper.MastLocationMapper">

    <resultMap type="jp.newpart.externalwarehouse.biz.domain.vo.MastLocationVo" id="MastLocationVoResult">
        <id property="id" column="id"/>
        <result property="whCd" column="wh_cd"/>
        <result property="zoneCd" column="zone_cd"/>
        <result property="locCd" column="loc_cd"/>
        <result property="locNm" column="loc_nm"/>
        <result property="locType" column="loc_type"/>
        <result property="locRow" column="loc_row"/>
        <result property="locCol" column="loc_col"/>
        <result property="locDan" column="loc_dan"/>
        <result property="locWdt" column="loc_wdt"/>
        <result property="locVtc" column="loc_vtc"/>
        <result property="locHgt" column="loc_hgt"/>
        <result property="memo" column="memo"/>
        <result property="deleteFlg" column="delete_flg"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createPgId" column="create_pg_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updatePgId" column="update_pg_id"/>
        <result property="version" column="version"/>
        <result property="whNm" column="wh_nm"/>
    </resultMap>

    <!-- ロケーションマスタ検索用の共通SQL -->
    <sql id="selectMastLocationVo">
        select
            ml.id,
            ml.wh_cd,
            ml.zone_cd,
            ml.loc_cd,
            ml.loc_nm,
            ml.loc_type,
            ml.loc_row,
            ml.loc_col,
            ml.loc_dan,
            ml.loc_wdt,
            ml.loc_vtc,
            ml.loc_hgt,
            ml.memo,
            ml.delete_flg,
            ml.create_time,
            ml.create_by,
            ml.create_pg_id,
            ml.update_time,
            ml.update_by,
            ml.update_pg_id,
            ml.version,
            mw.wh_nm
        from mast_location ml
        left join mast_warehouse mw
            on mw.wh_cd = ml.wh_cd
            and mw.delete_flg = '0'
    </sql>

    <!-- ロケーションマスタを検索リスト -->
    <select id="selectList" parameterType="jp.newpart.externalwarehouse.biz.domain.bo.MastLocationSearchBo"
            resultMap="MastLocationVoResult">
        <include refid="selectMastLocationVo"/>
        where ml.delete_flg = '0'
        <if test="whCd != null and whCd != ''">
            and ml.wh_cd = #{whCd}
        </if>
        <if test="locCd != null and locCd != ''">
            and ml.loc_cd like concat('%', #{locCd}, '%')
        </if>
        order by ml.wh_cd, ml.loc_cd
    </select>

    <!-- ロケーションマスタを検索 -->
    <select id="selectById" parameterType="String" resultMap="MastLocationVoResult">
        <include refid="selectMastLocationVo"/>
        where ml.id = #{id}
    </select>

    <!-- 同一の倉庫コード・ロケーションコードが存在するか確認する -->
    <select id="countByWhCdAndLocCd" resultType="int">
        select count(1)
        from mast_location
        where delete_flg = '0'
          and wh_cd = #{whCd}
          and loc_cd = #{locCd}
        <if test="excludeId != null and excludeId != ''">
            and id &lt;&gt; #{excludeId}
        </if>
    </select>

    <!-- ロケーションマスタを登録 -->
    <insert id="insert" parameterType="jp.newpart.common.biz.domain.entity.MastLocationEntity">
        insert into mast_location
        (
            id,
            wh_cd,
            zone_cd,
            loc_cd,
            loc_nm,
            loc_type,
            loc_row,
            loc_col,
            loc_dan,
            loc_wdt,
            loc_vtc,
            loc_hgt,
            memo,
            delete_flg,
            create_time,
            create_by,
            create_pg_id,
            update_time,
            update_by,
            update_pg_id,
            version
        )
        values
        (
            #{id},
            #{whCd},
            #{zoneCd},
            #{locCd},
            #{locNm},
            #{locType},
            #{locRow},
            #{locCol},
            #{locDan},
            #{locWdt},
            #{locVtc},
            #{locHgt},
            #{memo},
            #{deleteFlg},
            #{createTime},
            #{createBy},
            #{createPgId},
            #{updateTime},
            #{updateBy},
            #{updatePgId},
            #{version}
        )
    </insert>

    <!-- ロケーションマスタを修正（楽観的排他制御） -->
    <update id="update" parameterType="jp.newpart.common.biz.domain.entity.MastLocationEntity">
        update mast_location
        set
            wh_cd = #{whCd},
            loc_cd = #{locCd},
            memo = #{memo},
            update_time = #{updateTime},
            update_by = #{updateBy},
            update_pg_id = #{updatePgId},
            version = version + 1
        where id = #{id}
          and version = #{version}
    </update>

    <!-- ロケーションマスタを論理削除（楽観的排他制御） -->
    <update id="deleteLogical" parameterType="jp.newpart.common.biz.domain.entity.MastLocationEntity">
        update mast_location
        set
            delete_flg = '1',
            update_time = #{updateTime},
            update_by = #{updateBy},
            update_pg_id = #{updatePgId},
            version = version + 1
        where id = #{id}
          and version = #{version}
    </update>

    <!-- 倉庫名から倉庫情報を取得する -->
    <select id="selectWarehouseByNm" resultType="jp.newpart.common.biz.domain.entity.MastWarehouseEntity">
        select
            wh_cd as "whCd",
            wh_nm as "whNm"
        from mast_warehouse
        where delete_flg = '0'
          and wh_nm = #{whNm}
        order by wh_cd
        limit 1
    </select>

</mapper>
