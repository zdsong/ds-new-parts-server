<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.newpart.externalwarehouse.biz.mapper.BssAskMessageMapper">

    <resultMap type="BssAskMessageVo" id="BssAskMessageResult">
        <result property="id"       column="id"/>
        <result property="messages" column="messages"/>
        <result property="sendTime" column="send_time"/>
        <result property="orderId"  column="order_id"/>
        <result property="readStatus"  column="read_status"/>
        <result property="readUser"  column="read_user"/>
        <result property="receptionTime"  column="reception_time"/>
        <result property="orderId"   column="order_id"/>
        <result property="farmerId"  column="farmer_id"/>
        <result property="myFlag"    column="my_flag"/>
    </resultMap>

    <select id="selectUnReadMessageCnt" parameterType="BssAskMessageSearchBo" resultType="Integer">
        SELECT
            COUNT(1)
        FROM
            bss_ask_message bsm
        <where>
                bsm.read_status = '0'

            AND bsm.message_type = '0' <!--CRM-->
            <if test="farmerId != null  and farmerId != ''">
                and bsm.farmer_id = #{farmerId}
            </if>

            <if test="orderId != null  and orderId != ''">
                and bsm.order_id= #{orderId}
            </if>
            <if test="orderId == null or orderId == ''">
                and (bsm.order_id IS NULL OR TRIM(bsm.order_id) = '')
            </if>

        </where>

    </select>

    <select id="selectAskMessageList" parameterType="BssAskMessageSearchBo" resultMap="BssAskMessageResult">

        SELECT
            bsm.id,
            bsm.send_time,
            bsm.reception_time,
            bsm.read_user,
            bsm.read_status,
            bsm.messages,
            bsm.order_id,
            bsm.send_user,
            bsm.farmer_id,
            CASE bsm.send_user
                WHEN bsm.farmer_id THEN '1'
                ELSE '0' END
            AS my_flag
        FROM
            bss_ask_message bsm
        <where>
            <if test="farmerId != null  and farmerId != ''">
                and bsm.farmer_id = #{farmerId}
            </if>

            <if test="orderId != null  and orderId != ''">
                and bsm.order_id= #{orderId}
            </if>
            <if test="orderId == null or orderId == ''">
                and (bsm.order_id IS NULL OR TRIM(bsm.order_id) = '')
            </if>
          and bsm.sys_message_flg = '0'

        </where>

        order by bsm.send_time desc

    </select>

    <update id="readMessage" parameterType="BssAskMessageEntity">
        update bss_ask_message

        <trim prefix="SET" suffixOverrides=",">
            <if test="readStatus != null">
                read_status = #{readStatus},
            </if>
            <if test="readUser != null">
                read_user = #{readUser},
            </if>
            <if test="receptionTime != null">
                reception_time = #{receptionTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            <if test="updatePgId != null">
                update_pg_id = #{updatePgId},
            </if>
        </trim>
        <where>
            <if test="farmerId != null  and farmerId != ''">
                and farmer_id = #{farmerId}
            </if>

            <if test="orderId != null and orderId != ''">
                and order_id = #{orderId}
            </if>
            <if test="orderId == null or orderId == ''">
                and (order_id IS NULL OR TRIM(order_id) = '')
            </if>

            AND message_type = '0' <!--CRM-->

            AND read_status = '0'
        </where>

    </update>


</mapper>