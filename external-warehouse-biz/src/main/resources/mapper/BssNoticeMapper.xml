<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="jp.newpart.externalwarehouse.biz.mapper.BssNoticeMapper">

   <resultMap type="BssNoticeVo" id="BssNoticeResult">
        <result property="id" column="id"/>
        <result property="noticeType" column="notice_type"/>
        <result property="noticeParams" column="notice_params"/>
        <result property="noticeContent" column="notice_content"/>
        <result property="noticeUser" column="notice_user"/>
        <result property="noticeTime" column="notice_time"/>
        <result property="status" column="status"/>
    </resultMap>

    <sql id="selectBssNotice">
        select
          id,
          notice_type,
          notice_params,
          notice_content,
          notice_user,
          notice_time,
          status
        from bss_notice
    </sql>

    <select id="selectUnReadNoticeList" parameterType="String" resultMap="BssNoticeResult">
        select
        id,
        notice_type,
        notice_params,
        notice_content,
        notice_user,
        notice_time,
        status
        from bss_notice
        WHERE
            status = '0'
        AND discontinued_flg = '0'
        AND read_type = '1' <!--1:農家-->
        AND read_user = #{farmerId}
        ORDER BY notice_time desc
    </select>

    <select id="selectById" parameterType="String"  resultMap="BssNoticeResult">
        <include refid="selectBssNotice"/>
        where id = #{id}

    </select>


    <select id="selectUnReadNoticeCnt" parameterType="String" resultType="Integer">
        SELECT
            COUNT(1)
        FROM
            bss_notice
        WHERE
            status = '0'
        AND discontinued_flg = '0'
        AND read_type = '1' <!--1:農家-->
        AND read_user = #{farmerId}

    </select>

</mapper>