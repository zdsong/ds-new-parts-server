<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.newpart.externalwarehouse.biz.mapper.BssAskMessageTitleMapper">

    <resultMap type="BssAskMessageTitleEntity" id="BssAskMessageTitleEntityResult">
        <result property="id" column="id"/>
        <result property="farmerId" column="farmer_id"/>
        <result property="sendTime" column="send_time"/>
        <result property="orderId" column="order_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createPgId" column="create_pg_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updatePgId" column="update_pg_id"/>
        <result property="version" column="version"/>
    </resultMap>

    <sql id="selectBssAskMessageTitle">
        select
        id,
        farmer_id,
        send_time,
        order_id,
        status,
        create_time,
        create_by,
        create_pg_id,
        update_time,
        update_by,
        update_pg_id,
        version
        from bss_ask_message_title
    </sql>

    <select id="selectAskMessageTitleListForCheck" parameterType="BssAskMessageTitleEntity" resultMap="BssAskMessageTitleEntityResult">
        <include refid="selectBssAskMessageTitle"/>
        <where>
            farmer_id = #{farmerId}
            <if test="orderId != null  and orderId != ''">
                and order_id= #{orderId}
            </if>
            <if test="orderId == null or orderId == ''">
                and (order_id IS NULL OR TRIM(order_id) = '')
            </if>
        </where>
    </select>
</mapper>