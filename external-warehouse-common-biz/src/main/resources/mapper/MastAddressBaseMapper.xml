<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.newpart.common.biz.mapper.MastAddressBaseMapper">

    <resultMap type="OptionsAddressVo" id="OptionsKeyValueResult">
        <result property="key" column="key"/>
        <result property="value" column="value"/>
    </resultMap>

    <resultMap type="MastPostalCodeAddressEntity" id="MastAddressEntityResult">
        <result property="postalCode" column="postal_code"/>
        <result property="kenName" column="ken_name"/>
        <result property="cityName" column="city_name"/>
        <result property="townName" column="town_name"/>
        <result property="kenNameRomanLetters" column="ken_name_roman_letters"/>
        <result property="cityNameRomanLetters" column="city_name_roman_letters"/>
        <result property="townNameRomanLetters" column="town_name_roman_letters"/>

    </resultMap>

    <select id="selectAddressOptionsList" parameterType="OptionsParamBo" resultMap="OptionsKeyValueResult">
        select DISTINCT
        <if test="cmdOptionName != null  and cmdOptionName != ''">
            <if test="cmdOptionName =='ken'">
                ken_name as key,
                ken_name as value
            </if>
            <if test="cmdOptionName =='city'">
                city_name as key,
                city_name as value
            </if>
        </if>

        from mast_postal_code_address

        <where>
            <if test="cmdOptionName != null  and cmdOptionName != ''">
                <if test="cmdOptionName =='ken' or cmdOptionName =='city'">
                    <if test="conditionValue1 != null  and conditionValue1 != ''">
                        and CAST(ken_name AS VARCHAR) = #{conditionValue1}
                    </if>
                    <if test="conditionValue2 != null  and conditionValue2 != ''">
                        and ken_name = #{conditionValue2}
                    </if>
                </if>
            </if>
        </where>
        <if test="cmdOptionName != null  and cmdOptionName != ''">
            order by
            <if test="cmdOptionName =='ken'">
                ken_name
            </if>
            <if test="cmdOptionName =='city'">
                city_name
            </if>
        </if>
    </select>

    <select id="selectMastAddressByPostalCode" parameterType="String"  resultMap="MastAddressEntityResult">
        select
        distinct
        ken_name,
        city_name,
        town_name

        from mast_postal_code_address
        <where>
            and  REGEXP_REPLACE(postal_code,'-','') = #{postalCode}

        </where>

        limit 1
    </select>

 </mapper>