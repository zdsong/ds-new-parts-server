<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.newpart.quartz.mapper.SysCleanDataMapper">

	<delete id="deleteSysOperLogByDate" parameterType="String">
		delete
		from
			sys_oper_log
		where
			TO_CHAR(oper_time, 'YYYY-MM-DD') <![CDATA[<=]]> #{prevDate}

	</delete>

	<delete id="deleteSysLogininforByDate" parameterType="String">
		delete
		from
			sys_logininfor
		where
			TO_CHAR(login_time, 'YYYY-MM-DD') <![CDATA[<=]]> #{prevDate}

	</delete>

	<delete id="deleteJobLogByDate" parameterType="String">
		delete
		from
			sys_job_log
		where
			TO_CHAR(create_time, 'YYYY-MM-DD') <![CDATA[<=]]> #{prevDate}

	</delete>

	<delete id="deleteBssUserCertificationByDate" parameterType="String">
		delete
		from
			bss_user_certification
		where
			TO_CHAR(create_time, 'YYYY-MM-DD')  <![CDATA[<=]]> #{prevDate}

	</delete>
</mapper> 